@page "/game"
@using System.Timers
@implements IDisposable

<PageTitle>Play — kbWar2</PageTitle>

<h1>Play War</h1>

<div class="game-controls">
    <label>
        Players:
        <input type="number" min="2" max="52" @bind="playerCount" @bind:event="oninput" disabled="@gameStarted" class="player-count-input" />
    </label>
    <label>
        <input type="checkbox" @bind="shuffleWon" disabled="@gameStarted" />
        Shuffle recently won cards
    </label>

    @if (!gameStarted)
    {
        <button class="btn btn-primary" @onclick="StartGame">Deal</button>
    }
    else
    {
        <button class="btn btn-success" @onclick="ThrowOnce" disabled="@(autoPlaying || gameOver)">Throw</button>
        <button class="btn btn-outline-success" @onclick="ToggleAuto" disabled="@gameOver">
            @(autoPlaying ? "Pause" : "Auto")
        </button>
        <label class="ms-2">
            Speed:
            <input type="range" min="50" max="1000" step="50" @bind="autoIntervalMs" @bind:event="oninput" />
            @autoIntervalMs ms
        </label>
        <button class="btn btn-secondary ms-3" @onclick="NewGame">New Game</button>
    }
</div>

@if (gameStarted && game != null)
{
    <div class="game-stats">
        <span>Turn: <strong>@game.Counters.nTurns</strong></span>
        @if (game.Counters.nTotalWars > lastWarCount)
        {
            <span class="badge bg-danger ms-2">WAR!</span>
        }
        @if (gameOver)
        {
            <span class="badge bg-primary ms-2">
                @(game.State == kbCardGameWar.GameState.eInfiniteLoop
                    ? "Infinite loop detected"
                    : $"Player {game.Winner + 1} wins!")
            </span>
        }
    </div>

    @if (game.MostRecentWinners.Count > 0)
    {
        <div class="last-turn-box">
            <div class="pot-header">Last throw:</div>
            <div class="pot-winner">
                @if (game.MostRecentWinners.Count > 1)
                {
                    <span class="war-indicator">TIE — </span>
                }
                @foreach (var w in game.MostRecentWinners)
                {
                    <span>Player @(w + 1) wins pot&nbsp;</span>
                }
            </div>
            <div class="cards-played">
                @foreach (var card in wonCards)
                {
                    <span class="card-chip">@card</span>
                }
            </div>
        </div>
    }

    <div class="hands-grid">
        @for (int i = 0; i < game.nPlayers; i++)
        {
            var idx = i;
            var count = game.GetPlayerCount(idx);
            var isWinner = game.State == kbCardGameWar.GameState.eOverWithWinner && game.Winner == idx;
            <div class="hand-col @(isWinner ? "hand-winner" : "") @(count == 0 && !gameOver ? "hand-out" : "")">
                <div class="hand-label">Player @(idx + 1)</div>
                <div class="hand-count">@count cards</div>
                @if (count == 0 && !gameOver)
                {
                    <div class="hand-out-label">Out</div>
                }
                @if (isWinner)
                {
                    <div class="hand-out-label">Winner!</div>
                }
            </div>
        }
    </div>
}

@code {
    private int playerCount = 2;
    private bool shuffleWon = true;
    private bool gameStarted = false;
    private bool gameOver = false;
    private bool autoPlaying = false;
    private int autoIntervalMs = 300;
    private int lastWarCount = 0;
    private List<string> wonCards = [];

    private kbCardGameWar? game;
    private Timer? autoTimer;

    private void StartGame()
    {
        game = new kbCardGameWar(playerCount, new Random());
        game.ShuffleRecentlyWonCards = shuffleWon;
        game.ShuffleDeck();
        game.Deal();
        gameStarted = true;
        gameOver = false;
        lastWarCount = 0;
        wonCards = [];
    }

    private void ThrowOnce()
    {
        if (game == null || gameOver) return;
        lastWarCount = game.Counters.nTotalWars;
        game.NewTurn();
        UpdateWonCards();
        if (game.State != kbCardGameWar.GameState.eCurrentlyPlaying)
        {
            gameOver = true;
            StopAuto();
        }
    }

    private void UpdateWonCards()
    {
        if (game == null) return;
        var hand = game.MostRecentlyWonCards;
        wonCards = Enumerable.Range(0, Math.Min(hand.Count, 10))
            .Select(i => hand[i].ToString().Trim())
            .ToList();
        if (hand.Count > 10) wonCards.Add($"… +{hand.Count - 10} more");
    }

    private void ToggleAuto()
    {
        if (autoPlaying) StopAuto();
        else StartAuto();
    }

    private void StartAuto()
    {
        autoPlaying = true;
        autoTimer = new Timer(autoIntervalMs);
        autoTimer.Elapsed += OnAutoTick;
        autoTimer.AutoReset = true;
        autoTimer.Start();
    }

    private void StopAuto()
    {
        autoPlaying = false;
        autoTimer?.Stop();
        autoTimer?.Dispose();
        autoTimer = null;
    }

    private void OnAutoTick(object? sender, ElapsedEventArgs e)
    {
        InvokeAsync(() => { ThrowOnce(); StateHasChanged(); });
    }

    private void NewGame()
    {
        StopAuto();
        gameStarted = false;
        gameOver = false;
        lastWarCount = 0;
        wonCards = [];
        game = null;
    }

    public void Dispose() => StopAuto();
}
