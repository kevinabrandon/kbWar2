@page "/game"
@using System.Timers
@using System.Net
@implements IDisposable

<PageTitle>Play — kbWar2</PageTitle>

<h1>Play War</h1>

<div class="game-controls">
    <label>
        Players:
        <input type="number" min="2" max="52" @bind="playerCount" @bind:event="oninput"
               disabled="@gameStarted" class="player-count-input" />
    </label>
    <label>
        <input type="checkbox" @bind="shuffleWon" disabled="@gameStarted" />
        Shuffle recently won cards
    </label>

    @if (!gameStarted)
    {
        <button class="btn btn-primary" @onclick="StartGame">Deal</button>
    }
    else
    {
        <button class="btn btn-success" @onclick="ThrowOnce" disabled="@(autoPlaying || gameOver)">Throw</button>
        <button class="btn btn-outline-success" @onclick="ToggleAuto" disabled="@gameOver">
            @(autoPlaying ? "Pause" : "Auto")
        </button>
        <label class="ms-2">
            Speed:
            <input type="range" min="50" max="1000" step="50"
                   @bind="autoIntervalMs" @bind:event="oninput" />
            @autoIntervalMs ms
        </label>
        <button class="btn btn-secondary ms-3" @onclick="NewGame">New Game</button>
    }
</div>

@if (gameStarted && game != null)
{
    <div class="game-status-bar">
        <span>Turn: <strong>@game.Counters.nTurns</strong></span>
        <span class="ms-3">Wars: <strong>@game.Counters.nTotalWars</strong></span>
        @if (gameOver)
        {
            @if (game.State == kbCardGameWar.GameState.eInfiniteLoop)
            {
                <span class="status-badge status-loop">Infinite loop detected</span>
            }
            else
            {
                <span class="status-badge" style="background:@PlayerColor(game.Winner);color:#000">
                    PLAYER @(game.Winner + 1) WINS!!!
                </span>
            }
        }
    </div>

    <div class="game-area">
        <!-- Pot panel -->
        <div class="pot-panel">
            <div class="pot-panel-header">Pot</div>
            @if (game.MostRecentWinners.Count > 0)
            {
                @if (game.MostRecentWinners.Count > 1)
                {
                    <div class="pot-tie">TIE!!</div>
                }
                @foreach (var w in game.MostRecentWinners)
                {
                    <div class="pot-winner-label" style="background:@PlayerColor(w);color:#000">
                        Player @(w + 1) Won:
                    </div>
                }
                <pre class="hand-pre">@ColoredHand(game.MostRecentlyWonCards.ToString())</pre>
            }
        </div>

        <!-- Player columns -->
        <div class="hands-scroll">
            @for (int i = 0; i < game.nPlayers; i++)
            {
                int idx = i;
                int count = game.GetPlayerCount(idx);
                bool isOut = count == 0;
                bool isWinner = game.State == kbCardGameWar.GameState.eOverWithWinner && game.Winner == idx;

                @if (!isOut || showEmptyHands)
                {
                    <div class="player-col @(isOut ? "player-col-out" : "") @(isWinner ? "player-col-winner" : "")">
                        <div class="player-col-label" style="background:@PlayerColor(idx);color:#000">
                            Player @(idx + 1)
                        </div>
                        <div class="player-col-count">@count cards</div>
                        <pre class="hand-pre">@ColoredHand(game.GetPlayer(idx))</pre>
                    </div>
                }
            }
        </div>
    </div>

    <label class="show-empty-toggle">
        <input type="checkbox" @bind="showEmptyHands" /> Show empty hands
    </label>
}

@code {
    private int playerCount = 2;
    private bool shuffleWon = true;
    private bool gameStarted = false;
    private bool gameOver = false;
    private bool autoPlaying = false;
    private bool showEmptyHands = false;
    private int autoIntervalMs = 300;

    private kbCardGameWar? game;
    private Timer? autoTimer;

    private void StartGame()
    {
        game = new kbCardGameWar(playerCount, new Random());
        game.ShuffleRecentlyWonCards = shuffleWon;
        game.ShuffleDeck();
        game.Deal();
        gameStarted = true;
        gameOver = false;
    }

    private void ThrowOnce()
    {
        if (game == null || gameOver) return;
        game.NewTurn();
        if (game.State != kbCardGameWar.GameState.eCurrentlyPlaying)
        {
            gameOver = true;
            StopAuto();
        }
    }

    private void ToggleAuto()
    {
        if (autoPlaying) StopAuto();
        else StartAuto();
    }

    private void StartAuto()
    {
        autoPlaying = true;
        autoTimer = new Timer(autoIntervalMs);
        autoTimer.Elapsed += OnAutoTick;
        autoTimer.AutoReset = true;
        autoTimer.Start();
    }

    private void StopAuto()
    {
        autoPlaying = false;
        autoTimer?.Stop();
        autoTimer?.Dispose();
        autoTimer = null;
    }

    private void OnAutoTick(object? sender, ElapsedEventArgs e)
    {
        InvokeAsync(() => { ThrowOnce(); StateHasChanged(); });
    }

    private void NewGame()
    {
        StopAuto();
        gameStarted = false;
        gameOver = false;
        game = null;
    }

    private string PlayerColor(int i)
    {
        if (game == null || game.nPlayers == 0) return "#888";
        double hue = 360.0 * i / game.nPlayers;
        return $"hsl({hue:F0}, 100%, 50%)";
    }

    private MarkupString ColoredHand(string text)
    {
        if (string.IsNullOrEmpty(text)) return new MarkupString("");
        var html = WebUtility.HtmlEncode(text)
            .Replace("Ace",      "<span class='c-ace'>Ace</span>")
            .Replace("Hearts",   "<span class='c-red-suit'>Hearts</span>")
            .Replace("Diamonds", "<span class='c-red-suit'>Diamonds</span>")
            .Replace("Spades",   "<span class='c-blk-suit'>Spades</span>")
            .Replace("Clubs",    "<span class='c-blk-suit'>Clubs</span>");
        return new MarkupString(html);
    }

    public void Dispose() => StopAuto();
}
