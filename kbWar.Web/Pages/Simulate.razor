@page "/simulate"
@using System.Globalization

<PageTitle>Simulate — kbWar2</PageTitle>

<h1>Monte Carlo Simulation</h1>

<div class="sim-controls">
    <label>
        Players:
        <input type="number" min="2" max="52" @bind="playerCount" @bind:event="oninput" disabled="@running" class="player-count-input" />
    </label>
    <label>
        Games to simulate:
        <input type="number" min="1" max="1000000" @bind="totalGames" @bind:event="oninput" disabled="@running" class="games-input" />
    </label>
    <label>
        <input type="checkbox" @bind="shuffleWon" disabled="@running" />
        Shuffle recently won cards
    </label>
    <label title="Pick up the pot the way the original 2015 code did: interleaved in table order, reversed. Only matters when shuffling is off.">
        <input type="checkbox" @bind="legacyPot" disabled="@running" />
        2015 pot pickup order
    </label>
    <button class="btn btn-primary" @onclick="RunSimulation" disabled="@running">Run</button>
    @if (running)
    {
        <button class="btn btn-danger" @onclick="Cancel">Cancel</button>
    }
</div>

@if (running || results.Count > 0)
{
    <div class="sim-progress">
        <div class="progress" style="height: 22px;">
            <div class="progress-bar" role="progressbar"
                 style="width: @progressPct%"
                 aria-valuenow="@gamesRun" aria-valuemin="0" aria-valuemax="@totalGames">
                @gamesRun / @totalGames
            </div>
        </div>
    </div>
}

@if (results.Count > 0 && !running)
{
    @if (hist != null)
    {
        <div class="sim-chart">
            <div class="chart-title">Probability Distribution for the Number of Turns in a Game of War</div>
            <div class="chart-sub">
                @hist.Total.ToString("N0") completed games &mdash; @BucketSize turns per bucket
                @if (hist.Overflow > 0)
                {
                    <span> &mdash; @hist.Overflow.ToString("N0") games (@string.Format(CultureInfo.InvariantCulture, "{0:0.0}%", 100.0 * hist.Overflow / hist.Total)) went longer than @((NBuckets * BucketSize).ToString("N0")) turns and are off the right edge</span>
                }
                @if (hist.Loops > 0)
                {
                    <span> &mdash; @hist.Loops.ToString("N0") infinite loops not included</span>
                }
            </div>
            <svg viewBox="0 0 @ChartW @ChartH" role="img"
                 aria-label="Histogram of the number of turns per game, @BucketSize turns per bucket">

                @* Y gridlines and tick labels *@
                @for (int i = 0; i * hist.YStep <= hist.YMax * 1.0001; i++)
                {
                    double t = i * hist.YStep;
                    double gy = YOf(t);
                    @if (i > 0)
                    {
                        <line x1="@PlotL" y1="@S(gy)" x2="@(PlotL + PlotW)" y2="@S(gy)"
                              stroke="#2a2a3e" stroke-width="1" />
                    }
                    <g><text x="@(PlotL - 7)" y="@S(gy + 3.5)" text-anchor="end"
                          font-size="11" fill="#999">@t.ToString("0.####", CultureInfo.InvariantCulture)</text></g>
                }

                @* Bars *@
                @for (int b = 0; b < NBuckets; b++)
                {
                    int c = hist.Counts[b];
                    if (c == 0) continue;
                    double x = BarX(b) + 1;
                    double w = SlotW - 2;
                    double yTop = YOf(c / (double)hist.Total);
                    <path d="@BarPath(x, w, yTop, PlotT + PlotH)"
                          fill="@(b == hoverBucket ? "#4fc3f7" : "#3392d3")" />
                }

                @* X axis baseline, tick labels, axis titles *@
                <line x1="@PlotL" y1="@(PlotT + PlotH)" x2="@(PlotL + PlotW)" y2="@(PlotT + PlotH)"
                      stroke="#444" stroke-width="1" />
                @for (int t = 0; t <= 1400; t += 200)
                {
                    <g><text x="@S(PlotL + t / (double)BucketSize * SlotW)" y="@(PlotT + PlotH + 16)"
                          text-anchor="middle" font-size="11" fill="#999">@t.ToString("N0")</text></g>
                }
                <text x="@(PlotL + PlotW / 2)" y="@(ChartH - 8)" text-anchor="middle"
                      font-size="12" fill="#aaa">Number of Turns in a Game of War</text>
                <text x="14" y="@(PlotT + PlotH / 2)" text-anchor="middle"
                      font-size="12" fill="#aaa"
                      transform="rotate(-90 14 @(PlotT + PlotH / 2))">Probability</text>

                @* Full-height hover targets (bigger than the bars themselves) *@
                @for (int b = 0; b < NBuckets; b++)
                {
                    int bb = b;
                    <rect x="@S(BarX(b))" y="@PlotT" width="@S(SlotW)" height="@PlotH"
                          fill="transparent"
                          @onmouseover="() => hoverBucket = bb"
                          @onmouseout="() => hoverBucket = -1" />
                }

                @* Tooltip *@
                @if (hoverBucket >= 0)
                {
                    int c = hist.Counts[hoverBucket];
                    double p = c / (double)hist.Total;
                    string l1 = RangeLabel(hoverBucket) + " turns";
                    string l2 = string.Format(CultureInfo.InvariantCulture, "{0:N0} games ({1:0.00}%)", c, p * 100);
                    double bw = Math.Max(l1.Length, l2.Length) * 6.8 + 14;
                    double bx = Math.Clamp(BarX(hoverBucket) + SlotW / 2 - bw / 2, PlotL, PlotL + PlotW - bw);
                    double barTop = YOf(p);
                    double by = barTop - 46 < PlotT ? barTop + 8 : barTop - 46;
                    <g pointer-events="none">
                        <rect x="@S(bx)" y="@S(by)" width="@S(bw)" height="38" rx="3"
                              fill="#0d0d1a" stroke="#555" stroke-width="1" />
                        <text x="@S(bx + 7)" y="@S(by + 15)" font-size="11" fill="#e0e0e0">@l1</text>
                        <text x="@S(bx + 7)" y="@S(by + 30)" font-size="11" fill="#e0e0e0">@l2</text>
                    </g>
                }
            </svg>
            <details class="hist-table">
                <summary>Histogram data (table)</summary>
                <table>
                    <thead><tr><th>Turns</th><th>Games</th><th>Probability</th></tr></thead>
                    <tbody>
                        @for (int b = 0; b < NBuckets; b++)
                        {
                            <tr>
                                <td>@RangeLabel(b)</td>
                                <td>@hist.Counts[b].ToString("N0")</td>
                                <td>@string.Format(CultureInfo.InvariantCulture, "{0:0.000}%", 100.0 * hist.Counts[b] / hist.Total)</td>
                            </tr>
                        }
                        @if (hist.Overflow > 0)
                        {
                            <tr>
                                <td>@((NBuckets * BucketSize).ToString("N0"))+</td>
                                <td>@hist.Overflow.ToString("N0")</td>
                                <td>@string.Format(CultureInfo.InvariantCulture, "{0:0.000}%", 100.0 * hist.Overflow / hist.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        </div>
    }

    <div class="sim-output">
        <pre>@reportText</pre>
    </div>
}

@code {
    private int playerCount = 2;
    private int totalGames = 1000;
    private bool shuffleWon = true;
    private bool legacyPot = false;
    private bool running = false;
    private bool cancelled = false;
    private int gamesRun = 0;
    private double progressPct => totalGames > 0 ? (100.0 * gamesRun / totalGames) : 0;

    private record GameRecord(int Winner, bool Loop, kbCardGameWar.GameCounters Counters);
    private List<GameRecord> results = [];
    private const int SliceMs = 80;   // run games this long, then yield a frame to the browser

    private string reportText = "";
    private HistogramData? hist;
    private int hoverBucket = -1;

    private async Task RunSimulation()
    {
        running = true;
        cancelled = false;
        gamesRun = 0;
        results = [];
        reportText = "";
        hist = null;
        hoverBucket = -1;

        var rng = new Random();
        var game = new kbCardGameWar(playerCount, rng);
        game.ShuffleRecentlyWonCards = shuffleWon;
        game.LegacyPotOrder = legacyPot;
        int target = totalGames;

        var sw = System.Diagnostics.Stopwatch.StartNew();
        while (gamesRun < target && !cancelled)
        {
            long sliceEnd = sw.ElapsedMilliseconds + SliceMs;
            while (gamesRun < target && !cancelled && sw.ElapsedMilliseconds < sliceEnd)
            {
                game.Restart(playerCount);
                game.ShuffleDeck();
                game.Deal();
                game.PlayTillFinished();

                bool loop = game.State == kbCardGameWar.GameState.eInfiniteLoop;
                results.Add(new GameRecord(game.Winner, loop, game.Counters));
                gamesRun++;
            }
            StateHasChanged();
            // Task.Delay (not Task.Yield): in single-threaded WASM, Yield stays on the
            // same event-loop turn, so the browser never paints or processes clicks.
            await Task.Delay(1);
        }

        reportText = BuildReport();
        hist = BuildHistogram();
        running = false;
    }

    private void Cancel() => cancelled = true;

    private string BuildReport()
    {
        if (results.Count == 0) return "";

        int nGames = results.Count;
        int loops = results.Count(r => r.Loop);
        var sb = new System.Text.StringBuilder();

        sb.AppendLine("Number of games played: " + nGames.ToString("N0"));
        sb.AppendLine(shuffleWon
            ? "Shuffle the winning cards every turn"
            : "Perfect play, no shuffling of cards between turns, infinate loops possible!");
        if (legacyPot) sb.AppendLine("Original 2015 pot pickup order (interleaved)");

        for (int p = 0; p < playerCount; p++)
        {
            int wins = results.Count(r => r.Winner == p);
            sb.AppendLine("Player " + (p + 1) + " wins: " + wins.ToString("N0"));
        }
        sb.AppendLine("Number of infinite loops: " + loops.ToString("N0"));
        sb.AppendLine();

        // Throws: zeros are placeholders for infinite-loop games; exclude them from min/avg/total
        AppendStat(sb, "throws", "throws",
            results.Select(r => r.Loop ? 0 : r.Counters.nTurns).ToList(),
            hasMin: true, infiniteLoops: loops);

        AppendStat(sb, "total wars", "total wars",
            results.Select(r => r.Counters.nTotalWars).ToList(), hasMin: true);

        AppendStat(sb, "single wars", "single wars",
            results.Select(r => r.Counters.nSingleWars).ToList(), hasMin: true);

        AppendStat(sb, "double wars", "double wars",
            results.Select(r => r.Counters.nDoubleWars).ToList());

        AppendStat(sb, "triple wars", "triple wars",
            results.Select(r => r.Counters.nTripleWars).ToList());

        AppendStat(sb, "quad wars", "quad wars",
            results.Select(r => r.Counters.nQuadrupleWars).ToList());

        AppendStat(sb, "quintuple wars", "quintuple wars",
            results.Select(r => r.Counters.nQuintupleWars).ToList());

        AppendStat(sb, "sextuple wars", "sextuple wars",
            results.Select(r => r.Counters.nSextupleWars).ToList());

        AppendStat(sb, "septuble wars", "septuble wars",
            results.Select(r => r.Counters.nSeptupleWars).ToList());

        return sb.ToString();
    }

    // Matches the original GetMaxMinAvgCount logic from kbWarMainForm.cs
    private void AppendStat(System.Text.StringBuilder sb, string perGame, string allGames,
        List<int> values, bool hasMin = false, int infiniteLoops = 0)
    {
        int max = int.MinValue, min = int.MaxValue;
        long sum = 0;

        foreach (int v in values)
        {
            if (infiniteLoops > 0 && v == 0) continue;
            if (v > max) max = v;
            if (v < min) min = v;
            sum += v;
        }

        if (max == int.MinValue) max = 0;
        if (min == int.MaxValue) min = 0;

        double avg = (values.Count - infiniteLoops) > 0
            ? (double)sum / (values.Count - infiniteLoops)
            : 0;

        sb.AppendLine("Max " + perGame + " in a game: " + max.ToString("N0"));
        if (hasMin) sb.AppendLine("Min " + perGame + " in a game: " + min.ToString("N0"));
        sb.AppendLine("Avg " + perGame + " in a game: " + avg.ToString());
        sb.AppendLine("Total " + allGames + " in all games: " + sum.ToString("N0"));
        sb.AppendLine();
    }

    // ---- Histogram: 20 turns per bucket covering 0–1479; longer games are counted
    //      separately (hist.Overflow) and noted on the chart rather than piled into
    //      a final bucket that would skew the shape of the distribution ----

    private const int BucketSize = 20;
    private const int NBuckets = 74;
    private const int ChartW = 860, ChartH = 460;
    private const int PlotL = 55, PlotT = 14, PlotR = 12, PlotB = 54;
    private static int PlotW => ChartW - PlotL - PlotR;
    private static int PlotH => ChartH - PlotT - PlotB;
    private static double SlotW => (double)PlotW / NBuckets;

    private sealed class HistogramData
    {
        public int[] Counts = new int[NBuckets];
        public int Total;       // completed (non-loop) games, including overflow
        public int Overflow;    // completed games longer than the chart range
        public int Loops;       // infinite-loop games (excluded from the chart)
        public double YMax;
        public double YStep;
    }

    private HistogramData? BuildHistogram()
    {
        var h = new HistogramData();
        foreach (var r in results)
        {
            if (r.Loop) { h.Loops++; continue; }
            h.Total++;
            int b = r.Counters.nTurns / BucketSize;
            if (b >= NBuckets) { h.Overflow++; continue; }
            h.Counts[b]++;
        }
        if (h.Total == 0) return null;

        double maxProb = h.Counts.Max() / (double)h.Total;
        h.YStep = NiceStep(maxProb / 5.0);
        h.YMax = h.YStep * Math.Ceiling(maxProb / h.YStep);
        return h;
    }

    private static double NiceStep(double raw)
    {
        double mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        double n = raw / mag;
        return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * mag;
    }

    private static string S(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static double BarX(int b) => PlotL + b * SlotW;
    private double YOf(double prob) => PlotT + PlotH * (1 - prob / hist!.YMax);

    private static string RangeLabel(int b) =>
        $"{b * BucketSize}–{b * BucketSize + BucketSize - 1}";

    // Bar with a rounded top (data end) and a square baseline
    private static string BarPath(double x, double w, double yTop, double yBase)
    {
        double r = Math.Min(3, Math.Min(w / 2, yBase - yTop));
        return $"M{S(x)},{S(yBase)} L{S(x)},{S(yTop + r)} Q{S(x)},{S(yTop)} {S(x + r)},{S(yTop)} " +
               $"L{S(x + w - r)},{S(yTop)} Q{S(x + w)},{S(yTop)} {S(x + w)},{S(yTop + r)} " +
               $"L{S(x + w)},{S(yBase)} Z";
    }
}
