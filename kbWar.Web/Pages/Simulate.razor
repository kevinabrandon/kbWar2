@page "/simulate"

<PageTitle>Simulate — kbWar2</PageTitle>

<h1>Monte Carlo Simulation</h1>

<div class="sim-controls">
    <label>
        Players:
        <input type="number" min="2" max="52" @bind="playerCount" disabled="@running" class="player-count-input" />
    </label>
    <label>
        Games to simulate:
        <input type="number" min="1" max="1000000" @bind="totalGames" disabled="@running" class="games-input" />
    </label>
    <label>
        <input type="checkbox" @bind="shuffleWon" disabled="@running" />
        Shuffle recently won cards
    </label>
    <button class="btn btn-primary" @onclick="RunSimulation" disabled="@running">Run</button>
    @if (running)
    {
        <button class="btn btn-danger" @onclick="Cancel">Cancel</button>
    }
</div>

@if (running || results.Count > 0)
{
    <div class="sim-progress">
        <div class="progress" style="height: 22px;">
            <div class="progress-bar" role="progressbar"
                 style="width: @progressPct%"
                 aria-valuenow="@gamesRun" aria-valuemin="0" aria-valuemax="@totalGames">
                @gamesRun / @totalGames
            </div>
        </div>
    </div>
}

@if (results.Count > 0 && !running)
{
    <div class="sim-output">
        <pre>@BuildReport()</pre>
    </div>
}

@code {
    private int playerCount = 2;
    private int totalGames = 1000;
    private bool shuffleWon = true;
    private bool running = false;
    private bool cancelled = false;
    private int gamesRun = 0;
    private double progressPct => totalGames > 0 ? (100.0 * gamesRun / totalGames) : 0;

    private record GameRecord(int Winner, bool Loop, kbCardGameWar.GameCounters Counters);
    private List<GameRecord> results = [];
    private const int BatchSize = 50;

    private async Task RunSimulation()
    {
        running = true;
        cancelled = false;
        gamesRun = 0;
        results = [];

        var rng = new Random();
        var game = new kbCardGameWar(playerCount, rng);
        game.ShuffleRecentlyWonCards = shuffleWon;
        int remaining = totalGames;

        while (remaining > 0 && !cancelled)
        {
            int batch = Math.Min(BatchSize, remaining);
            for (int i = 0; i < batch && !cancelled; i++)
            {
                game.Restart(playerCount);
                game.ShuffleDeck();
                game.Deal();
                game.PlayTillFinished();

                bool loop = game.State == kbCardGameWar.GameState.eInfiniteLoop;
                results.Add(new GameRecord(game.Winner, loop, game.Counters));
                gamesRun++;
            }
            remaining -= batch;
            StateHasChanged();
            await Task.Yield();
        }

        running = false;
    }

    private void Cancel() => cancelled = true;

    private string BuildReport()
    {
        if (results.Count == 0) return "";

        int nGames = results.Count;
        int loops = results.Count(r => r.Loop);
        var sb = new System.Text.StringBuilder();

        sb.AppendLine("Number of games played: " + nGames.ToString("N0"));
        sb.AppendLine(shuffleWon
            ? "Shuffle the winning cards every turn"
            : "Perfect play, no shuffling of cards between turns, infinate loops possible!");

        for (int p = 0; p < playerCount; p++)
        {
            int wins = results.Count(r => r.Winner == p);
            sb.AppendLine("Player " + (p + 1) + " wins: " + wins.ToString("N0"));
        }
        sb.AppendLine("Number of infinite loops: " + loops.ToString("N0"));
        sb.AppendLine();

        // Throws: zeros are placeholders for infinite-loop games; exclude them from min/avg/total
        AppendStat(sb, "throws", "throws",
            results.Select(r => r.Loop ? 0 : r.Counters.nTurns).ToList(),
            hasMin: true, infiniteLoops: loops);

        AppendStat(sb, "total wars", "total wars",
            results.Select(r => r.Counters.nTotalWars).ToList(), hasMin: true);

        AppendStat(sb, "single wars", "single wars",
            results.Select(r => r.Counters.nSingleWars).ToList(), hasMin: true);

        AppendStat(sb, "double wars", "double wars",
            results.Select(r => r.Counters.nDoubleWars).ToList());

        AppendStat(sb, "triple wars", "triple wars",
            results.Select(r => r.Counters.nTripleWars).ToList());

        AppendStat(sb, "quad wars", "quad wars",
            results.Select(r => r.Counters.nQuadrupleWars).ToList());

        AppendStat(sb, "quintuple wars", "quintuple wars",
            results.Select(r => r.Counters.nQuintupleWars).ToList());

        AppendStat(sb, "sextuple wars", "sextuple wars",
            results.Select(r => r.Counters.nSextupleWars).ToList());

        AppendStat(sb, "septuble wars", "septuble wars",
            results.Select(r => r.Counters.nSeptupleWars).ToList());

        return sb.ToString();
    }

    // Matches the original GetMaxMinAvgCount logic from kbWarMainForm.cs
    private void AppendStat(System.Text.StringBuilder sb, string perGame, string allGames,
        List<int> values, bool hasMin = false, int infiniteLoops = 0)
    {
        int max = int.MinValue, min = int.MaxValue;
        long sum = 0;

        foreach (int v in values)
        {
            if (infiniteLoops > 0 && v == 0) continue;
            if (v > max) max = v;
            if (v < min) min = v;
            sum += v;
        }

        if (max == int.MinValue) max = 0;
        if (min == int.MaxValue) min = 0;

        double avg = (values.Count - infiniteLoops) > 0
            ? (double)sum / (values.Count - infiniteLoops)
            : 0;

        sb.AppendLine("Max " + perGame + " in a game: " + max.ToString("N0"));
        if (hasMin) sb.AppendLine("Min " + perGame + " in a game: " + min.ToString("N0"));
        sb.AppendLine("Avg " + perGame + " in a game: " + avg.ToString());
        sb.AppendLine("Total " + allGames + " in all games: " + sum.ToString("N0"));
        sb.AppendLine();
    }
}
